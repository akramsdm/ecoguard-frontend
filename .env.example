VITE_API_BASE_URL=/api/v1

# --- Live basemap (step 5) ---
# MapTiler is the only supported production tile provider.
# Copy this file to .env and put your real key there; .env is gitignored.
# Without a key, local dev falls back to the public OSM raster with a visible
# warning, and `npm run build` fails (production must never ship the fallback).
VITE_MAP_TILE_PROVIDER=maptiler
# MapTiler API key: a per-account URL-safe token, no spaces. Free dev keys work.
VITE_MAPTILER_KEY=YOUR_MAPTILER_API_KEY_HERE
# Raster style id. streets-v2 (default) is a general-purpose basemap with clear
# roads and labels under the boundary overlays; basic-v2 is a lighter alternative.
VITE_MAPTILER_STYLE=streets-v2